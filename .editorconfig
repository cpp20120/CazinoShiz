root = true

[*.cs]
# Server-side code does not need explicit await continuation configuration.
# The default context behavior is intentional here.
dotnet_diagnostic.MA0004.severity = none

# Keep methods reasonably compact without forcing noisy splits around admin handlers.
MA0051.maximum_lines_per_method = 80

[tests/**/*.cs]
# Underscore-separated test names are intentional: Method_State_Result reads better in xUnit output.
dotnet_diagnostic.CA1707.severity = none

# Tests commonly keep local fakes, fixture helpers, and multiple related cases in one file.
dotnet_diagnostic.MA0048.severity = none

# DispatchProxy requires proxy classes to remain unsealed.
dotnet_diagnostic.CA1852.severity = none

[host/**/Pages/**/*.cshtml.cs]
# Razor page model files follow Razor's page naming convention, not the contained model type name.
dotnet_diagnostic.MA0048.severity = none

[host/CasinoShiz.AdminBff/Pages/*.cshtml.cs]
# Razor page model files follow Razor's page naming convention, not the contained model type name.
dotnet_diagnostic.MA0048.severity = none

[host/CasinoShiz.Host/Pages/Admin/MetaQuests.cshtml.cs]
# Razor binding and the JSON editor document intentionally use mutable List<T> collections.
dotnet_diagnostic.MA0016.severity = none

[host/CasinoShiz.Host/Pages/Admin/EventsModel.cs]
# This page handler keeps one cohesive data-loading transaction for the admin screen.
dotnet_diagnostic.MA0051.severity = none

[host/CasinoShiz.Host/Pages/Admin/ChallengesModel.cs]
# This page handler keeps one cohesive data-loading transaction for the admin screen.
dotnet_diagnostic.MA0051.severity = none

[host/CasinoShiz.Host/Pages/Admin/IndexModel.cs]
# This page handler keeps one cohesive data-loading transaction for the admin screen.
dotnet_diagnostic.MA0051.severity = none

[host/CasinoShiz.Host/Pages/Admin/MetaTournamentModel.cs]
# This page handler keeps one cohesive data-loading transaction for the admin screen.
dotnet_diagnostic.MA0051.severity = none

[host/CasinoShiz.Host/Pages/Admin/Settings.cshtml.cs]
# This page handler validates and persists one complete settings section atomically.
dotnet_diagnostic.MA0051.severity = none

[host/CasinoShiz.Host/Pages/Admin/MetaSeasonsModel.cs]
# These helpers are called through the Razor Model instance from the .cshtml page.
dotnet_diagnostic.S2325.severity = none
dotnet_diagnostic.CA1822.severity = none

[**/*Events.cs]
# Domain event files intentionally group small event records by aggregate.
dotnet_diagnostic.MA0048.severity = none

[framework/BotFramework.Sdk/Pipeline/UpdateMiddleware.cs]
# Pipeline abstractions are intentionally grouped with the delegate and middleware contract.
dotnet_diagnostic.MA0048.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1716.severity = none

[framework/BotFramework.Sdk/Commands/ICommandMiddleware.cs]
# Middleware conventionally names the continuation "next".
dotnet_diagnostic.CA1716.severity = none

[framework/BotFramework.Sdk/Execution/DeferredOutcome/DeferredOutcomeWagerContracts.cs]
# These records form one public composition contract; generic marker parameters intentionally partition DI registrations.
dotnet_diagnostic.MA0048.severity = none
dotnet_diagnostic.S2326.severity = none

[framework/BotFramework.Sdk/Execution/DeferredOutcome/DeferredOutcomeWagerActions.cs]
# The three tightly coupled lifecycle actions share internal validation conventions.
dotnet_diagnostic.MA0048.severity = none

